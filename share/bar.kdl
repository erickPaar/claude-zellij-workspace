// The status bar czw puts at the bottom of every tab: zjstatus, in Catppuccin Mocha.
// Needs a Nerd Font in the terminal. czw fills in the @...@ values.
plugin location="file:@ZJSTATUS@" {
    format_left   "{mode}#[fg=#89b4fa,bg=#181825,bold]   {session} "
    format_center "{tabs}"
    format_right  "{command_waiting}{notifications}#[fg=#6c7086,bg=#181825]  {datetime} "
    format_space  "#[bg=#181825]"
    format_hide_on_overlength "true"
    format_precedence "lrc"

    hide_frame_for_single_pane "true"
    pane_frame_style "full"

    mode_locked       "#[fg=#6c7086,bg=#181825]  "
    mode_normal       "#[fg=#fab387,bg=#181825]#[fg=#11111b,bg=#fab387,bold] COMMAND#[fg=#fab387,bg=#181825]"
    mode_pane         "#[fg=#cba6f7,bg=#181825]#[fg=#11111b,bg=#cba6f7,bold]PANE#[fg=#cba6f7,bg=#181825]"
    mode_tab          "#[fg=#cba6f7,bg=#181825]#[fg=#11111b,bg=#cba6f7,bold]TAB#[fg=#cba6f7,bg=#181825]"
    mode_resize       "#[fg=#cba6f7,bg=#181825]#[fg=#11111b,bg=#cba6f7,bold]RESIZE#[fg=#cba6f7,bg=#181825]"
    mode_move         "#[fg=#cba6f7,bg=#181825]#[fg=#11111b,bg=#cba6f7,bold]MOVE#[fg=#cba6f7,bg=#181825]"
    mode_scroll       "#[fg=#f9e2af,bg=#181825]#[fg=#11111b,bg=#f9e2af,bold]SCROLL#[fg=#f9e2af,bg=#181825]"
    mode_search       "#[fg=#f9e2af,bg=#181825]#[fg=#11111b,bg=#f9e2af,bold]SEARCH#[fg=#f9e2af,bg=#181825]"
    mode_enter_search "#[fg=#f9e2af,bg=#181825]#[fg=#11111b,bg=#f9e2af,bold]SEARCH#[fg=#f9e2af,bg=#181825]"
    mode_session      "#[fg=#cba6f7,bg=#181825]#[fg=#11111b,bg=#cba6f7,bold]SESSION#[fg=#cba6f7,bg=#181825]"
    mode_rename_tab   "#[fg=#cba6f7,bg=#181825]#[fg=#11111b,bg=#cba6f7,bold]RENAME#[fg=#cba6f7,bg=#181825]"
    mode_rename_pane  "#[fg=#cba6f7,bg=#181825]#[fg=#11111b,bg=#cba6f7,bold]RENAME#[fg=#cba6f7,bg=#181825]"
    mode_default_to_mode "normal"

    tab_normal              "#[fg=#6c7086,bg=#181825] {index} #[fg=#a6adc8,bg=#181825]{name} "
    tab_normal_fullscreen   "#[fg=#6c7086,bg=#181825] {index} #[fg=#a6adc8,bg=#181825]{name}  "
    tab_normal_sync         "#[fg=#6c7086,bg=#181825] {index} #[fg=#a6adc8,bg=#181825]{name} <> "
    tab_active              "#[fg=#89b4fa,bg=#181825]#[fg=#11111b,bg=#89b4fa,bold]{index} {name}#[fg=#89b4fa,bg=#181825]"
    tab_active_fullscreen   "#[fg=#89b4fa,bg=#181825]#[fg=#11111b,bg=#89b4fa,bold]{index} {name} #[fg=#89b4fa,bg=#181825]"
    tab_active_sync         "#[fg=#89b4fa,bg=#181825]#[fg=#11111b,bg=#89b4fa,bold]{index} {name} <>#[fg=#89b4fa,bg=#181825]"
    tab_rename              "#[fg=#fab387,bg=#181825]#[fg=#11111b,bg=#fab387,bold]{index} {name}#[fg=#fab387,bg=#181825]"
    tab_separator           "#[bg=#181825] "

    // Who needs you, from the tab markers: red ● waiting, green ✓ your turn. It only reads
    // the file czw mark writes (every tab has its own bar, so the command must be cheap).
    command_waiting_command    "cat @STATUS@"
    command_waiting_format     "{stdout}"
    command_waiting_interval   "2"
    command_waiting_rendermode "dynamic"

    notification_format_unread           "#[fg=#f9e2af,bg=#181825,bold] 󰂞 {message} "
    notification_format_no_notifications ""
    notification_show_interval           "10"

    datetime          "#[fg=#a6adc8,bg=#181825]{format}"
    datetime_format   "%H:%M"
    datetime_timezone "@TZ@"
}
