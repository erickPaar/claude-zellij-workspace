#!/usr/bin/env bash
# czw: Claude Code sessions as tabs of one zellij session, that survive closing the
# terminal and rebooting the machine.
#
#   czw open DIR [--all|--fresh]   open (or reattach to) the workspace described in DIR
#   czw new NAME [FOLDER] [TAB]    from inside a workspace: a new named session in a new tab
#   czw claude NAME [ARGS...]      run session NAME (resume it, or start it with that name)
#   czw list [DIR]                 the sessions a workspace opens
#   czw mark STATE                 from Claude Code hooks: show the session's state in its tab
#   czw status [--bar|--panel]     which sessions need you (--zjstatus: colored, for the bar)
#   czw next                       go to the next tab that needs you (Alt a)
#   czw shell                      show or hide a shell beside this tab's session (Alt n)
#   czw statusline                 Claude Code's status line (settings.json statusLine)
#   czw version
set -euo pipefail

CZW_VERSION="0.1.0"
self="$(readlink -f "${BASH_SOURCE[0]}")"
root="$(cd "$(dirname "$self")/.." && pwd)"
state="${XDG_STATE_HOME:-$HOME/.local/state}/czw"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/czw"

die() { echo "czw: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "$1 is not installed ($2)"; }

# A workspace is a folder with sessions.txt, and optionally workspace.conf and tabs.kdl.
ws_name() {
  local dir="$1" name=""
  [[ -f "$dir/workspace.conf" ]] && name="$(sed -n 's/[[:space:]]*#.*//; s/^name[[:space:]]*=[[:space:]]*//p' "$dir/workspace.conf" | tail -1)"
  echo "${name:-$(basename "$dir")}"
}

# The zellij config folder czw runs with: the user's own config is never touched.
# (--config-dir, not --config: with --config, the file's default_layout would win over
# --new-session-with-layout.)
config_dir() {
  mkdir -p "$cache/zellij"
  sed "s#@CZW_ROOT@#$root#g" "$root/share/config.kdl" > "$cache/zellij/config.kdl"
  echo "$cache/zellij"
}

exists() { zellij list-sessions -n -s 2>/dev/null | grep -qx "$1"; }

# zjstatus asks for permissions in the one-line bar, where the prompt is easy to miss and
# the bar stays blank until answered. czw pins the plugin it installs, so it grants them.
grant_bar() {
  local plugin="${XDG_DATA_HOME:-$HOME/.local/share}/czw/plugins/zjstatus.wasm"
  local perms="${XDG_CACHE_HOME:-$HOME/.cache}/zellij/permissions.kdl"
  [[ -f "$plugin" ]] || return 0
  grep -qF "\"$plugin\"" "$perms" 2>/dev/null && return 0
  mkdir -p "$(dirname "$perms")"
  printf '"%s" {\n    ReadApplicationState\n    ChangeApplicationState\n    RunCommands\n}\n' "$plugin" >> "$perms"
}

cmd_open() {
  local dir="" mode=""
  for a in "$@"; do
    case "$a" in
      --all|--fresh) mode="$a" ;;
      -*) die "unknown option $a" ;;
      *) dir="$a" ;;
    esac
  done
  [[ -n "$dir" ]] || die "usage: czw open DIR [--all|--fresh]"
  dir="$(cd "$dir" && pwd)"
  [[ -f "$dir/sessions.txt" ]] || die "$dir has no sessions.txt"
  [[ -z "${ZELLIJ:-}" ]] || die "already inside zellij: detach first (Alt g, d)"
  need zellij "https://zellij.dev"
  local name layout cfg
  name="$(ws_name "$dir")"
  layout="$cache/layouts/$name.kdl"
  cfg="$(config_dir)"
  mkdir -p "$state/workspaces" && echo "$dir" > "$state/workspaces/$name"
  grant_bar
  # The zellij server copies this shell's environment into every pane: a name from a czw claude
  # this was started under must not pass for the workspace's.
  unset CZW_SESSION
  python3 "$root/lib/layout.py" "$dir" "$layout"
  python3 "$root/lib/layout.py" --default "$cfg/layouts/czw.kdl" "$name"
  if [[ "$mode" == --fresh ]] && exists "$name"; then
    read -r -p "This closes the zellij session $name and reopens every tab. Continue? [y/N] " ok
    [[ "$ok" == [yY] ]] || exit 1
    zellij delete-session --force "$name" >/dev/null
  fi
  if exists "$name"; then
    if [[ "$mode" == --all ]]; then
      exec zellij --config-dir "$cfg" attach "$name" --force-run-commands
    fi
    exec zellij --config-dir "$cfg" attach "$name"
  fi
  exec zellij --config-dir "$cfg" --session "$name" --new-session-with-layout "$layout"
}

cmd_claude() {
  local name="${1:?usage: czw claude NAME [ARGS...]}"
  shift
  need claude "https://claude.com/claude-code"
  mkdir -p "$state/known"
  # The session's name, for what runs inside it (hooks, plugins): Claude Code doesn't pass its
  # name to every plugin.
  export CZW_SESSION="$name"
  # claude runs as a child, not exec'd: zellij records THIS command line for
  # resurrection, and a running claude hides its own arguments.
  if [[ -e "$state/known/$name" ]]; then
    claude --resume "$name" "$@"
  else
    echo "New session: $name"
    touch "$state/known/$name"
    claude -n "$name" "$@"
  fi
}

cmd_new() {
  local name="${1:?usage: czw new NAME [FOLDER] [TAB]}"
  local folder tab dir
  folder="$(cd "${2:-$PWD}" && pwd)"
  [[ -n "${ZELLIJ_SESSION_NAME:-}" ]] || die "run it inside a czw workspace"
  dir="$(cat "$state/workspaces/$ZELLIJ_SESSION_NAME" 2>/dev/null)" || die "$ZELLIJ_SESSION_NAME is not a czw workspace"
  local prefix=""
  [[ -f "$dir/workspace.conf" ]] && prefix="$(sed -n 's/[[:space:]]*#.*//; s/^strip_prefix[[:space:]]*=[[:space:]]*//p' "$dir/workspace.conf" | tail -1)"
  tab="${3:-${name#"$prefix"}}"
  if ! grep -qE "^${name}[[:space:]]" "$dir/sessions.txt"; then
    printf '%-24s %s%s\n' "$name" "${folder/#$HOME/\~}" "$([[ -n "${3:-}" ]] && echo " $tab")" >>"$dir/sessions.txt"
    echo "sessions.txt: + $name"
  fi
  zellij action new-tab --layout-string "$(python3 "$root/lib/layout.py" --tab "$name" "$folder" "$tab" "$ZELLIJ_SESSION_NAME")"
}

# Show a Claude session's state in its tab name, from Claude Code hooks:
#   working " name" (a Nerd Font spinner), done "✓ name" (your turn), attention
#   "● name" (a permission prompt or a question waits), idle "○ name" (started, no
#   task yet), clear "name". `unblock` only turns attention back into working (after a
#   tool ran, the prompt was answered). Outside zellij: no-op.
cmd_mark() {
  local want="${1:-}" marker="" pane tab_id tab_name base new
  [[ -n "${ZELLIJ_PANE_ID:-}" && -n "${ZELLIJ_SESSION_NAME:-}" ]] || return 0
  case "$want" in
    working) marker=" " ;;
    done) marker="✓ " ;;
    attention) marker="● " ;;
    idle) marker="○ " ;;
    clear|unblock) marker="" ;;
    *) die "usage: czw mark working|done|attention|idle|unblock|clear" ;;
  esac
  pane="$ZELLIJ_PANE_ID"
  read -r tab_id tab_name < <(timeout 3 zellij action list-panes --tab --json 2>/dev/null | python3 -c '
import json, sys
for p in json.load(sys.stdin):
    if not p.get("is_plugin") and str(p.get("id")) == sys.argv[1]:
        print(p["tab_id"], p["tab_name"]); break
' "$pane") || return 0
  [[ -n "${tab_id:-}" ]] || return 0
  base="$tab_name"
  for m in " " "… " "✓ " "● " "○ "; do base="${base#"$m"}"; done
  if [[ "$want" == unblock ]]; then
    [[ "$tab_name" == "● "* ]] || return 0
    marker=" "
  fi
  new="$marker$base"
  [[ "$new" == "$tab_name" ]] || timeout 3 zellij action rename-tab-by-id "$tab_id" "$new" >/dev/null 2>&1 || true
  # The bell first, while this process and its parents are still there to lead to the pane.
  if [[ "$want" == attention && "$new" != "$tab_name" && "${CZW_NOTIFY:-auto}" != off && "${CZW_NOTIFY:-auto}" != bar ]]; then
    ring_bell
  fi
  [[ "$want" == attention || "$want" == "done" ]] && [[ "$new" != "$tab_name" ]] && ( notify "$want" "$base" "$tab_id" & )
  # The bar reads this file instead of asking zellij: written only when a mark changes.
  mkdir -p "$state/status"
  cmd_status --zjstatus --session "$ZELLIJ_SESSION_NAME" > "$state/status/$ZELLIJ_SESSION_NAME.tmp" 2>/dev/null \
    && mv "$state/status/$ZELLIJ_SESSION_NAME.tmp" "$state/status/$ZELLIJ_SESSION_NAME"
}

# Tell the user a session waits (attention) or finished (done), if they are not looking at
# it: a message in the zjstatus bar when its tab is not the active one, and a desktop
# notification when the terminal is not in front. CZW_NOTIFY=off turns both off;
# CZW_NOTIFY=bar keeps only the bar. Runs in the background of `czw mark`.
notify() {
  local want="$1" name="$2" tab_id="$3" active title text
  [[ "${CZW_NOTIFY:-auto}" == off ]] && return 0
  active="$(timeout 3 zellij action list-tabs --json 2>/dev/null | python3 -c '
import json, sys
print(next((t["tab_id"] for t in json.load(sys.stdin) if t.get("active")), ""))' 2>/dev/null)"
  if [[ "$want" == attention ]]; then title="● $name needs you"; text="A permission prompt or a question is waiting."
  else title="✓ $name finished"; text="Your turn."; fi
  if [[ "$active" != "$tab_id" ]]; then
    timeout 2 zellij pipe "zjstatus::notify::$title" </dev/null >/dev/null 2>&1 || true
  fi
  [[ "${CZW_NOTIFY:-auto}" == bar ]] && return 0
  if command -v powershell.exe >/dev/null; then
    # On WSL: a Windows toast, only when Windows Terminal is not in front (in front, the
    # bar already says it).
    timeout 10 powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(wslpath -w "$root/share/notify-windows.ps1")" \
      -Title "$title" -Message "$text" -OnlyIfAway >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    [[ "$active" != "$tab_id" ]] && timeout 5 notify-send -a czw "$title" "$text" >/dev/null 2>&1 || true
  elif command -v osascript >/dev/null; then
    [[ "$active" != "$tab_id" ]] && timeout 5 osascript -e "display notification \"$text\" with title \"$title\"" >/dev/null 2>&1 || true
  fi
}

# A bell in the session's own pane, so a terminal that flashes on a bell (Windows Terminal's
# bellStyle "taskbar", for one) shows that a session needs you. Hooks run with no terminal of
# their own, so the bell goes to the first ancestor that has one (the session's claude). Called
# from cmd_mark itself, not the background notify: by then this process may be gone. Never fails.
ring_bell() {
  local p=$$ t
  while [[ "$p" =~ ^[0-9]+$ && "$p" -gt 1 ]]; do
    t="$(ps -o tty= -p "$p" 2>/dev/null | tr -d ' ')" || return 0
    if [[ -n "$t" && "$t" != "?" && "$t" != "??" ]]; then
      { printf '\a' > "/dev/$t"; } 2>/dev/null || true
      return 0
    fi
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')" || return 0
  done
}

# Go to the next tab that needs you: after the current one, wrapping around, first a ●
# (waiting), else a ✓ (your turn). Bound to Alt a.
cmd_next() {
  local id
  id="$(timeout 3 zellij action list-tabs --json 2>/dev/null | python3 -c '
import json, sys
tabs = sorted(json.load(sys.stdin), key=lambda t: t["position"])
cur = next((i for i, t in enumerate(tabs) if t.get("active")), 0)
order = tabs[cur + 1:] + tabs[:cur + 1]
for mark in ("● ", "✓ "):
    hit = next((t for t in order if t["name"].startswith(mark)), None)
    if hit:
        print(hit["tab_id"]); break
')" || return 0
  [[ -n "$id" ]] && timeout 3 zellij action go-to-tab-by-id "$id" >/dev/null 2>&1 || true
}

# A shell beside the session in this tab, shown and hidden in turn. No shell (or one that
# exited): open one right of the session, in its folder. A shell showing: the session goes
# full screen over it, the shell still running. The session full screen: back to the split,
# the shell focused. The shell is the pane titled shell, the session the one running czw
# claude. Bound to Alt n, it runs in a 1x1 floating pane that has the focus: every step
# focuses its pane by id first.
cmd_shell() {
  local tab plan verb arg
  tab="$(timeout 3 zellij action list-tabs --json 2>/dev/null | python3 -c '
import json, sys
print(next((t["tab_id"] for t in json.load(sys.stdin) if t.get("active")), ""))')" || return 0
  [[ -n "$tab" ]] || return 0
  plan="$(timeout 3 zellij action list-panes --json 2>/dev/null | python3 -c '
import json, re, sys
tab = int(sys.argv[1])
panes = [p for p in json.load(sys.stdin) if p.get("tab_id") == tab and not p.get("is_plugin") and not p.get("is_floating")]
def is_shell(p):
    return p.get("title") == "shell"
def runs_claude(p):
    return re.search(r"(^|[/ ])czw claude ", "%s %s" % (p.get("terminal_command") or "", p.get("pane_command") or ""))
session = next((p for p in panes if not is_shell(p) and runs_claude(p)), None)
if session:
    s = session["id"]
    shell = next((p for p in panes if is_shell(p) and not p.get("exited")), None)
    if shell is None:
        for p in panes:
            if is_shell(p): print("close", p["id"])
        print("focus", s)
        if session.get("is_fullscreen"): print("fullscreen")
        print("open", session.get("pane_cwd") or "")
    elif session.get("is_fullscreen"):
        print("focus", s); print("fullscreen"); print("focus", shell["id"])
    else:
        print("focus", s); print("fullscreen")
' "$tab")" || return 0
  while read -r verb arg; do
    case "$verb" in
      focus) timeout 3 zellij action focus-pane-id "terminal_$arg" >/dev/null ;;
      close) timeout 3 zellij action close-pane --pane-id "terminal_$arg" ;;
      fullscreen) timeout 3 zellij action toggle-fullscreen ;;
      open) timeout 3 zellij action new-pane --direction right --name shell --cwd "${arg:-$PWD}" >/dev/null ;;
    esac
  done <<< "$plan"
}

# Which sessions need you. `czw status` lists the tabs with a marker; `--bar` prints the
# short summary the status bar shows ("● 2  ✓ 1", or nothing when no one waits);
# `--panel` prints a "## Sessions" section, one marked line per state, for a side panel.
cmd_status() {
  local mode=0 session="${ZELLIJ_SESSION_NAME:-}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --bar) mode=1 ;;
      --zjstatus) mode=2 ;;
      --panel) mode=3 ;;
      --session) session="${2:-}"; shift $(( $# > 1 ? 1 : 0 )) ;;
      *) die "usage: czw status [--bar|--zjstatus|--panel] [--session NAME]" ;;
    esac
    shift
  done
  # A panel refreshes on its own: no session is a line to show, not an error.
  if [[ -z "$session" && "$mode" == 3 ]]; then printf '## Sessions\nno sessions\n'; return 0; fi
  [[ -n "$session" ]] || die "not inside zellij: give --session NAME"
  # A session that is gone fails the query: for the panel that is "no sessions", exit 0.
  { timeout 3 zellij --session "$session" action query-tab-names 2>/dev/null || [[ "$mode" == 3 ]]; } | python3 -c '
import sys
bar = sys.argv[1] in ("1", "2")
styled = sys.argv[1] == "2"
panel = sys.argv[1] == "3"
names = [l.rstrip("\n") for l in sys.stdin if l.strip()]
need = [n[2:] for n in names if n.startswith("● ")]
done = [n[2:] for n in names if n.startswith("✓ ")]
busy = [n[2:] for n in names if n.startswith(" ") or n.startswith("… ")]
if bar:
    parts = []
    if need: parts.append(("#[fg=#f38ba8,bg=#181825,bold]" if styled else "") + "● %d" % len(need))
    if done: parts.append(("#[fg=#a6e3a1,bg=#181825,bold]" if styled else "") + "✓ %d" % len(done))
    if busy: parts.append(("#[fg=#89b4fa,bg=#181825]" if styled else "") + " %d" % len(busy))
    out = "  ".join(parts)
    print(out + ("  " if styled and out else ""))
elif panel:
    # The side panel colors a line by its first character: ● red, ✓ green, ⠋ blue.
    print("## Sessions")
    for mark, label, group in (("●", "needs you", need), ("✓", "your turn", done), ("⠋", "working", busy)):
        if group: print("%s %-10s %s" % (mark, label, ", ".join(group)))
    if not names: print("no sessions")
    elif not (need or done or busy): print("nothing waiting")
else:
    for label, group in (("needs you", need), ("your turn", done), ("working", busy)):
        if group: print("%-10s %s" % (label, ", ".join(group)))
    if not (need or done or busy): print("nothing waiting")
' "$mode"
}

cmd_list() {
  local dir="${1:-}"
  if [[ -z "$dir" && -n "${ZELLIJ_SESSION_NAME:-}" ]]; then dir="$(cat "$state/workspaces/$ZELLIJ_SESSION_NAME" 2>/dev/null || true)"; fi
  [[ -n "$dir" ]] || die "usage: czw list DIR"
  grep -vE '^[[:space:]]*(#|$)' "$dir/sessions.txt"
}

case "${1:-}" in
  open) shift; cmd_open "$@" ;;
  claude) shift; cmd_claude "$@" ;;
  new) shift; cmd_new "$@" ;;
  list) shift; cmd_list "$@" ;;
  mark) shift; cmd_mark "$@" ;;
  status) shift; cmd_status "$@" ;;
  next) shift; cmd_next ;;
  shell) shift; cmd_shell ;;
  statusline) exec python3 "$root/lib/statusline.py" ;;
  version|--version) echo "czw $CZW_VERSION" ;;
  *) sed -n '2,15p' "$self" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
